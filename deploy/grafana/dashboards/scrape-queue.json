{
  "title": "scrape-queue",
  "uid": "scrape-queue",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "tags": [
    "scrape-queue"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Queue depth",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sq_queue_depth",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Pages fetched per second",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(sq_pages_fetched_total[5m])) by (target, fetcher)",
          "legendFormat": "{{target}} {{fetcher}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Page failures by type",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(sq_page_failures_total[5m])) by (target, error_type)",
          "legendFormat": "{{target}} {{error_type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Page duration p95",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sq_page_duration_seconds_bucket[5m])) by (le, target))",
          "legendFormat": "{{target}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Rate limit wait p95",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sq_rate_limit_wait_seconds_bucket[5m])) by (le, domain))",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Circuit state (2 = open)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sq_circuit_state",
          "legendFormat": "{{domain}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Job outcomes",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(increase(sq_jobs_finished_total[15m])) by (state)",
          "legendFormat": "{{state}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Browser worker RSS",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sq_browser_rss_bytes",
          "legendFormat": "{{worker}}",
          "refId": "A"
        }
      ]
    }
  ]
}