# copy to .env for local runs
API_KEYS=dev-key-write:write,dev-key-read:read,dev-key-admin:admin
DATABASE_URL=postgresql+psycopg://scrape:scrape@postgres:5432/scrape
REDIS_URL=redis://redis:6379/0
REDBEAT_REDIS_URL=redis://redis:6379/1
S3_ENDPOINT=http://minio:9000
S3_BUCKET=scrape-results
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
LOG_LEVEL=INFO
SCRAPEQUEUE_USER_AGENT=scrape-queue (contact: ysajang via GitHub)
